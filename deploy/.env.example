# Public DNS name of the VM (Caddy obtains the certificate automatically).
FORGE_DOMAIN=forge.example.com

# Pin the API image version for reproducible upgrades.
FORGE_API_IMAGE=ghcr.io/hiberus-industria/forge-api:latest

# PostgreSQL password (generate one: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me

# Keycloak realm (issuer) and the audience access tokens must carry.
FORGE_OIDC_ISSUER=https://sso.example.com/realms/hiberus
FORGE_OIDC_AUDIENCE=forge-api

# GitHub App (see docs/github-app.md). The private key goes to deploy/secrets/github-app.pem.
FORGE_GITHUB_ORG=hiberus-industria
FORGE_GITHUB_APP_ID=
FORGE_GITHUB_INSTALLATION_ID=
FORGE_GITHUB_WEBHOOK_SECRET=change-me

# Optional.
FORGE_RECONCILE_INTERVAL=10m
FORGE_LOG_LEVEL=info
